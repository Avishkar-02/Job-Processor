# ─────────────────────────────────────────────────────────────
# Dockerfile — Spring Boot backend (job-processor)
#
# WHY multi-stage build?
# Stage 1 (builder): has Maven + JDK to compile the project.
#   The compiled output is a fat JAR (~30 MB).
# Stage 2 (runtime): only has JRE (no Maven, no source code).
#   Final image is much smaller and has a smaller attack surface.
#
# The pattern: build in a heavy image, copy ONLY the artifact
# into a lean image. The builder layer is discarded.
# ─────────────────────────────────────────────────────────────

# ── Stage 1: BUILD ────────────────────────────────────────────
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /build

# Copy Maven wrapper FIRST
COPY .mvn/ .mvn/
COPY mvnw .
RUN chmod +x mvnw

# NOW copy pom.xml and cache dependencies (mvnw exists now)
COPY pom.xml .
RUN ./mvnw dependency:go-offline -B 2>/dev/null || true

# Copy source and build
COPY src/ src/
RUN ./mvnw package -B -DskipTests

# ── Stage 2: RUNTIME ─────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine AS runtime

# Create a non-root user.
# Running as root inside a container is a security risk —
# if the app is compromised, the attacker has root inside the container.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

WORKDIR /app

# Copy ONLY the compiled JAR from the builder stage.
# Nothing from the builder (Maven, source, .class files) comes along.
COPY --from=builder /build/target/*.jar app.jar

# Expose the port Spring Boot listens on (configured in application.properties)
EXPOSE 8080

# ── JVM tuning for containers ─────────────────────────────────
# -XX:+UseContainerSupport  → JVM reads cgroup limits, not host RAM.
#   Without this, JVM sees the host's 16 GB and allocates heap accordingly —
#   causing OOM kills in a container limited to 512 MB.
# -XX:MaxRAMPercentage=75   → Use up to 75% of container RAM for heap.
# -Djava.security.egd=...   → Faster startup: use /dev/urandom instead of
#   /dev/random for random number generation (avoids blocking on entropy).
ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75.0", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
